#!/usr/bin/env node
// bot-harness — one thread, many accounts, on Claude Code desktop. See README.md.
import { load, upsert, remove, emails, setLabel, display, resolve } from '../src/accounts.mjs';
import { probeAll } from '../src/prober.mjs';
import { pickHealthy } from '../src/router.mjs';
import { get as getConfig, setModel } from '../src/config.mjs';
import { newestSession, resumeOn } from '../src/seat.mjs';
import { currentEmail } from '../src/whoami.mjs';
import { rotate as sessionRotate, makeHandoff, transcriptPath, readTurns, conversationChars } from '../src/session.mjs';
const [cmd, sub, ...rest] = process.argv.slice(2);
const arg = (f) => { const i = rest.indexOf(`--${f}`); return i>-1 ? rest[i+1] : null; };
const model = arg('model') || getConfig().model;

async function main(){
  if (cmd === 'config'){ if (sub==='model' && rest[0]){ console.log(`✓ model → ${setModel(rest[0])}`); return; } console.log(`model: ${getConfig().model}`); return; }
  if (cmd === 'token'){
    if (sub === 'add' || sub === 'update'){ const [email, token] = rest; if (!email || !token) return die('usage: bot-harness token add <email> <token>');
      const n = upsert(email, token); console.log(`✓ ${email} saved (${n} account${n>1?'s':''} in the pool)`); return; }
    if (sub === 'label'){ const [email, ...rest2] = rest; if (!email) return die('usage: bot-harness token label <email> [label]   (omit the label to clear it)');
      const set = setLabel(email, rest2.join(' '));
      if (set === null && !load().some(r => r.email === email)) return die(`not in the pool: ${email}`);
      console.log(set ? `✓ ${email} shows as ${set}` : `✓ ${email} shows as its email again`); return; }
    if (sub === 'remove'){ const [email] = rest; if (!email) return die('usage: bot-harness token remove <email>');
      console.log(remove(email) ? `✓ removed ${email}` : `not found: ${email}`); return; }
    if (sub === 'list' || !sub){
      const rows = load(); if (!rows.length) return console.log('no accounts yet — bot-harness token add <email> <token>');
      console.log(`probing ${rows.length} account(s) for ${model}…`);
      await probeAll(rows, model, r => console.log(`  ${r.ok?'\x1b[32m✓\x1b[0m':'\x1b[31m✗\x1b[0m'} ${r.email.padEnd(28)} \x1b[2m${r.why}\x1b[0m`)); return; }
    return die('token: add | update | label | remove | list');
  }
  if (cmd === 'status' || cmd === 'whoami'){
    const { email } = currentEmail(); console.log(`this session is paying: \x1b[1m${email? display(email) : 'unknown'}\x1b[0m`);
    console.log(`pool: ${load().map(display).join(' · ') || '(empty)'}`); return;
  }
  if (cmd === 'seat'){
    const here = currentEmail().email;
    console.log(`probing your accounts for ${model}…`);
    const { email, results } = await pickHealthy(model, { exclude: here && here!=='not-in-pool' ? [] : [], onResult: r => console.log(`  ${r.ok?'\x1b[32m✓\x1b[0m':'\x1b[31m✗\x1b[0m'} ${r.email} \x1b[2m${r.why}\x1b[0m`) });
    if (!email) return die(`no account has ${tier} headroom right now`);
    const token = load().find(r => r.email===email).token;
    const session = arg('resume') || newestSession();
    console.log(`\nseat → \x1b[1m${email}\x1b[0m${session?` · resuming ${session.slice(0,8)}…`:''}`);
    const r = resumeOn(token, session); process.exit(r.status ?? 0);
  }
  if (cmd === 'session'){
    if (sub === 'rotate'){
      if (rest.includes('--in-place')){
        const { rotateInPlace } = await import('../src/session.mjs');
        const { newestSession } = await import('../src/seat.mjs');
        const sid = arg('resume') || newestSession();
        const r = await rotateInPlace(sid);
        const pct = Math.round(100 - r.after.chars/r.before.chars*100);
        console.log(`\x1b[1m✓ context refreshed — same chat, work carried over\x1b[0m`);
        console.log(`  memory used: ${Math.round(r.before.chars/4000)}k → ${(r.after.chars/4000).toFixed(1)}k  \x1b[2m(${pct}% freed)\x1b[0m`);
        const { findRemoteServerPid } = await import('../src/app-seat.mjs');
        const srv = findRemoteServerPid();
        if (srv && !rest.includes('--stage')){
          console.log(`  \x1b[2mreconnecting…\x1b[0m`);
          const { writeFileSync: wf } = await import('node:fs');
          wf(`${process.env.HOME}/.bot-harness/pending-switch`, String(srv));
        } else {
          console.log(`  \x1b[2mreconnect once to continue in this same chat\x1b[0m`);
        }
        return;
      }
      await sessionRotate(); return; }
    if (sub === 'snapshot'){ const { newestSession } = await import('../src/seat.mjs'); const sid=newestSession(); const r=await makeHandoff(sid); console.log(`snapshot: ${r.turns} turns → ${r.snap}\n\n${r.handoff}`); return; }
    const { newestSession } = await import('../src/seat.mjs'); const sid=newestSession(); const p=sid&&transcriptPath(sid);
    if (!p) { console.log('no session here'); return; }
    const chars = conversationChars(p); const tok = Math.round(chars/4); const pct = Math.min(99, Math.round(tok/200000*100));
    console.log(`session ${sid.slice(0,8)} · memory used: ~${(tok/1000).toFixed(0)}k of 200k (${pct}% full)`); return;
  }
  if (cmd === 'switch'){
    if (!sub) return die('usage: bot-harness switch <account> [--stage]   (an email, or a label if you set one)');
    const email = resolve(sub); if (!email) return die(`not in the pool: ${sub}`);
    const { setSeatFor, findRemoteServerPid } = await import('../src/app-seat.mjs');
    setSeatFor(email);
    if (rest.includes('--stage')){ console.log(`\x1b[1m→ ${display(email)}\x1b[0m \x1b[2m(staged — restart to apply)\x1b[0m`); return; }
    const srv = findRemoteServerPid();
    if (srv){
      console.log(`\x1b[1m→ ${display(email)}\x1b[0m \x1b[2m· reconnecting…\x1b[0m`);
      const { writeFileSync: wf } = await import('node:fs');
      wf(`${process.env.HOME}/.bot-harness/pending-switch`, String(srv));
    } else {
      console.log(`\x1b[1m→ ${display(email)}\x1b[0m \x1b[2m(restart the session to apply)\x1b[0m`);
    }
    return;
  }
  if (cmd === 'mobile'){ const { run } = await import('../src/mobile.mjs'); return run(sub); }
  if (cmd === 'app'){ const { run } = await import('../src/app-seat.mjs'); return run(sub, rest); }
  if (cmd === 'doctor'){ const { doctor } = await import('../doctor.mjs'); return doctor(); }
  die('bot-harness token|status|seat|switch|session|mobile|app|config|doctor');
}
function die(m){ console.error(m); process.exit(1); }
main().catch(e => die(String(e.message||e)));
