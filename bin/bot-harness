#!/usr/bin/env node
// bot-harness — one thread, many accounts, on Claude Code desktop. See README.md.
import { load, upsert, remove, emails } from '../src/accounts.mjs';
import { probeAll } from '../src/prober.mjs';
import { pickHealthy } from '../src/router.mjs';
import { get as getConfig, setModel } from '../src/config.mjs';
import { newestSession, resumeOn } from '../src/seat.mjs';
import { currentEmail } from '../src/whoami.mjs';
import { rotate as sessionRotate, makeHandoff, transcriptPath, readTurns } from '../src/session.mjs';
const [cmd, sub, ...rest] = process.argv.slice(2);
const arg = (f) => { const i = rest.indexOf(`--${f}`); return i>-1 ? rest[i+1] : null; };
const model = arg('model') || getConfig().model;

async function main(){
  if (cmd === 'config'){ if (sub==='model' && rest[0]){ console.log(`✓ model → ${setModel(rest[0])}`); return; } console.log(`model: ${getConfig().model}`); return; }
  if (cmd === 'token'){
    if (sub === 'add' || sub === 'update'){ const [email, token] = rest; if (!email || !token) return die('usage: bot-harness token add <email> <token>');
      const n = upsert(email, token); console.log(`✓ ${email} saved (${n} account${n>1?'s':''} in the pool)`); return; }
    if (sub === 'remove'){ const [email] = rest; if (!email) return die('usage: bot-harness token remove <email>');
      console.log(remove(email) ? `✓ removed ${email}` : `not found: ${email}`); return; }
    if (sub === 'list' || !sub){
      const rows = load(); if (!rows.length) return console.log('no accounts yet — bot-harness token add <email> <token>');
      console.log(`probing ${rows.length} account(s) for ${model}…`);
      await probeAll(rows, model, r => console.log(`  ${r.ok?'\x1b[32m✓\x1b[0m':'\x1b[31m✗\x1b[0m'} ${r.email.padEnd(28)} \x1b[2m${r.why}\x1b[0m`)); return; }
    return die('token: add | update | remove | list');
  }
  if (cmd === 'status' || cmd === 'whoami'){
    const { email } = currentEmail(); console.log(`this session is paying: \x1b[1m${email||'unknown'}\x1b[0m`);
    console.log(`pool: ${emails().join(' · ') || '(empty)'}`); return;
  }
  if (cmd === 'seat'){
    const here = currentEmail().email;
    console.log(`probing your accounts for ${model}…`);
    const { email, results } = await pickHealthy(model, { exclude: here && here!=='not-in-pool' ? [] : [], onResult: r => console.log(`  ${r.ok?'\x1b[32m✓\x1b[0m':'\x1b[31m✗\x1b[0m'} ${r.email} \x1b[2m${r.why}\x1b[0m`) });
    if (!email) return die(`no account has ${tier} headroom right now`);
    const token = load().find(r => r.email===email).token;
    const session = arg('resume') || newestSession();
    console.log(`\nseat → \x1b[1m${email}\x1b[0m${session?` · resuming ${session.slice(0,8)}…`:''}`);
    const r = resumeOn(token, session); process.exit(r.status ?? 0);
  }
  if (cmd === 'session'){
    if (sub === 'rotate'){ await sessionRotate(); return; }
    if (sub === 'snapshot'){ const { newestSession } = await import('../src/seat.mjs'); const sid=newestSession(); const r=await makeHandoff(sid); console.log(`snapshot: ${r.turns} turns → ${r.snap}\n\n${r.handoff}`); return; }
    const { newestSession } = await import('../src/seat.mjs'); const sid=newestSession(); const p=sid&&transcriptPath(sid); console.log(p?`current session ${sid.slice(0,8)}… · ${readTurns(p,9999).length} turns on disk`:'no session here'); return;
  }
  if (cmd === 'switch'){
    const email = sub; if (!email) return die('usage: bot-harness switch <email>');
    const { setSeatFor } = await import('../src/app-seat.mjs');
    setSeatFor(email);
    console.log(`\x1b[1mseat staged → ${email}\x1b[0m`);
    console.log(`\x1b[2mthe account is bound to the session PROCESS — to switch this thread onto ${email},`);
    console.log(`RESTART the session: close & reopen this thread (or quit+relaunch the app). A plain`);
    console.log(`reconnect reuses the same process and stays on the old account. After restart: bot-harness status\x1b[0m`);
    return;
  }
  if (cmd === 'app'){ const { run } = await import('../src/app-seat.mjs'); return run(sub, rest); }
  if (cmd === 'doctor'){ const { doctor } = await import('../doctor.mjs'); return doctor(); }
  die('bot-harness token|status|seat|switch|session|app|config|doctor');
}
function die(m){ console.error(m); process.exit(1); }
main().catch(e => die(String(e.message||e)));
